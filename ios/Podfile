source 'https://token:KzfLB1RYYNCXNqr9@dl.cloudsmith.io/basic/credolab/proxyen-sdk/cocoapods/index.git'
source 'https://cdn.cocoapods.org/'


$RNFirebaseAsStaticFramework = true

def node_require(script)
  require Pod::Executable.execute_command('node', ['-p',
    "require.resolve('#{script}', {paths: [process.argv[1]]})", __dir__]).strip
end

node_require('react-native/scripts/react_native_pods.rb')
node_require('react-native-permissions/scripts/setup.rb')

platform :ios, '15.1'
prepare_react_native_project!

setup_permissions(%w[
  AppTrackingTransparency
  Camera
  LocationAccuracy
  LocationAlways
  LocationWhenInUse
  MediaLibrary
  Notifications
])

# ❌ Remove this to avoid duplicate/react-core conflicts on RN 0.76
# pod 'React-Core/DevSupport', :path => '../node_modules/react-native/'

linkage = ENV['USE_FRAMEWORKS']
if linkage
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! linkage: linkage.to_sym
end

target 'ivoo_ecommerce' do
  use_frameworks! linkage: :static
  $RNFirebaseAsStaticFramework = true

  config = use_native_modules!

  use_react_native!(
    path: config[:reactNativePath],
    hermes_enabled: true,
    fabric_enabled: false, # keep Old Architecture while upgrading
    app_path: "#{Pod::Config.instance.installation_root}/.."
  )

  target 'ivoo_ecommerceTests' do
    inherit! :complete
  end

  post_install do |installer|
    react_native_post_install(installer, config[:reactNativePath], mac_catalyst_enabled: false)

    # ✅ Lift every pod to at least iOS 15.1 to avoid low-target pod errors
    min_target = '15.1'
    installer.pods_project.targets.each do |t|
      t.build_configurations.each do |cfg|
        cur = cfg.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] || '0'
        if Gem::Version.new(cur) < Gem::Version.new(min_target)
          cfg.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = min_target
        end
      end
    end

    # Your debug info setting is fine to keep:
    installer.pods_project.build_configurations.each do |cfg|
      cfg.build_settings['DEBUG_INFORMATION_FORMAT'] = 'dwarf-with-dsym'
    end
  end
end
